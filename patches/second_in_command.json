  ],
  "changes": [
    {
      "id": "xo-slots-three",
      "title": "Three executive officer slots, not four",
      "why": "Each slot is six fleet-wide skills that vanilla's 15 skill points never paid for.",
      "before": "4 slots (your saved setting)",
      "after": "3 slots (the mod's own default and minimum)",
      "ops": [
        {
          "op": "luna",
          "key": "sc_xoSlotsForPlayer",
          "expect_default": "3",
          "set": "3"
        }
      ]
    },
    {
      "id": "xo-progression-mode",
      "title": "Executive officer slots open with your level",
      "why": "With every slot open, a level 1 captain could hire three officers and hold six fleet skills, where the game gives one skill point a level.",
      "before": "All slots open from the start",
      "after": "The first slot is open from the start, the second at level 5, the third at level 10",
      "ops": [
        {
          "op": "luna",
          "key": "sc_progressionMode",
          "expect_default_sha256": "fcbcf165908dd18a9e49f7ff27810176db8e9f63b4352213741664245224f8aa",
          "set": "true"
        },
        {
          "op": "luna",
          "key": "sc_progressionLevelSlot2",
          "expect_default": "5",
          "set": "5"
        },
        {
          "op": "luna",
          "key": "sc_progressionLevelSlot3",
          "expect_default": "10",
          "set": "10"
        }
      ]
    },
    {
      "id": "xo-xp-half",
      "title": "Executive officers level at half speed",
      "why": "Slower levels stand in for Survival's slower progression.",
      "before": "Executive officer XP x1",
      "after": "Executive officer XP x0.5",
      "ops": [
        {
          "op": "luna",
          "key": "sc_officerXPMult",
          "expect_default": "1",
          "set": "0.5"
        }
      ]
    },
    {
      "id": "xo-comm-rarity",
      "title": "Executive officers for hire are as scarce as Survival officers",
      "why": "Survival cuts officers for hire to 0.15 of normal.",
      "before": "85% of markets list one or two each month",
      "after": "15% of markets list one, sometimes two (about 0.15 of before)",
      "ops": [
        {
          "op": "luna",
          "key": "sc_officerCommRarity",
          "expect_default_sha256": "a7248eeb45eb1ce247f81693283e22e8b39e8a50890cecd22d02e75025547d90",
          "set": "Rare"
        },
        {
          "op": "class_const",
          "jar": "jars/SecondInCommand.jar",
          "class": "second_in_command/scripts/ExecutiveOfficerCommAdder",
          "method": "reportEconomyMonthEnd",
          "type": "float",
          "from": 0.4,
          "to": 0.15,
          "count": 1,
          "method_fp": "821562bebc0ddfbe"
        }
      ]
    },
    {
      "id": "xo-derelict-rarity",
      "title": "Fewer executive officers in derelict cryopods",
      "why": "Survival halves officers found in cryopods. Takes effect in new saves.",
      "before": "Up to 40% of the sector's pod count",
      "after": "Up to 20%",
      "ops": [
        {
          "op": "luna",
